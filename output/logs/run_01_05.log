. do "$CODE/01_import_irpef.do"

. *==============================================================================*
. * 01_import_irpef.do
. * Redditi e principali variabili IRPEF su base sub-comunale, anni d'imposta
. * 2019-2024, 38 CAP. Ogni file e' in formato lungo: anno - CAP - voce - importo.
. * Le intestazioni cambiano tra anni (Importi/Valori, IRPEF/Irpef, apostrofi
. * doppi nel 2024, spazi finali), quindi le voci vengono normalizzate.
. *
. * Output: $WORK/irpef_long_all.dta  tutte le voci (chiave anno-CAP-voce)
. *         $WORK/irpef_cap_year.dta  CAP x anno con le variabili usate
. *         $WORK/irpef_city_year.dta totali cittadini per anno
. *==============================================================================*
. version 16

. di as txt _n "{hline 78}" _n "01 - IMPORT IRPEF PER CAP" _n "{hline 78}"

------------------------------------------------------------------------------
01 - IMPORT IRPEF PER CAP
------------------------------------------------------------------------------

. 
. tempfile acc

. local first 1

. 
. forvalues y = 2019/2024 {
  2.     local f "$RAW/${F_IRPEF_STUB}`y'.csv"
  3.     capture confirm file "`f'"
  4.     if _rc local f "$RAW/${F_IRPEF_STUB}`y' (1).csv"
  5.     capture confirm file "`f'"
  6.     if _rc {
  7.         di as error "File IRPEF per l'anno `y' non trovato in $RAW"
  8.         exit 601
  9.     }
 10.     imp_csv using "`f'"
 11. 
.     * colonne per contenuto dell'intestazione, con le posizioni come riserva
.     local vy ""
 12.     local vc ""
 13.     local vd ""
 14.     local vv ""
 15.     capture findvar, pattern("anno")
 16.     if !_rc local vy `r(varname)'
 17.     capture findvar, pattern("(^| )cap( |$)")
 18.     if !_rc local vc `r(varname)'
 19.     capture findvar, pattern("variabil")
 20.     if !_rc local vd `r(varname)'
 21.     capture findvar, pattern("import|valor")
 22.     if !_rc local vv `r(varname)'
 23.     if "`vy'" == "" | "`vc'" == "" | "`vd'" == "" | "`vv'" == "" {
 24.         di as txt "  intestazioni non riconosciute: uso le prime quattro colonne"
 25.         unab allv : _all
 26.         tokenize `allv'
 27.         local vy `1'
 28.         local vc `2'
 29.         local vd `3'
 30.         local vv `4'
 31.     }
 32.     keep `vy' `vc' `vd' `vv'
 33.     local i 0
 34.     foreach new in anno cap descr valore {
 35.         local ++i
 36.         local old : word `i' of `vy' `vc' `vd' `vv'
 37.         if "`old'" != "`new'" rename `old' `new'
 38.     }
 39.     tonum anno cap valore
 40.     quietly count if anno != `y'
 41.     if r(N) > 0 di as error "  Attenzione: " r(N) " righe con anno diverso da `y'"
 42. 
.     * normalizzazione della voce: minuscole, spazi singoli, senza apostrofi
.     gen d = ustrlower(stritrim(ustrtrim(descr)))
 43.     quietly replace d = subinstr(d, "'", "", .)
 44. 
.     gen str12 code = ""
 45.     quietly {
 46.         replace code = "ncontrib"  if d == "numero contribuenti"
 47.         replace code = "imp_f"     if ustrregexm(d, "^reddito imponibile ?- ?frequenza$")
 48.         replace code = "imp_a"     if ustrregexm(d, "^reddito imponibile ?- ?ammontare")
 49.         replace code = "lav_f"     if ustrregexm(d, "^reddito da lavoro dipendente e assimilati ?- ?frequenza")
 50.         replace code = "lav_a"     if ustrregexm(d, "^reddito da lavoro dipendente e assimilati ?- ?ammontare")
 51.         replace code = "pen_f"     if ustrregexm(d, "^reddito da pensione ?- ?frequenza")
 52.         replace code = "pen_a"     if ustrregexm(d, "^reddito da pensione ?- ?ammontare")
 53.         replace code = "tot_f"     if ustrregexm(d, "^reddito complessivo ?- ?frequenza")
 54.         replace code = "tot_a"     if ustrregexm(d, "^reddito complessivo ?- ?ammontare")
 55.         replace code = "cle0_f"    if ustrregexm(d, "minore o uguale a zero euro ?- ?frequenza")
 56.         replace code = "cle0_a"    if ustrregexm(d, "minore o uguale a zero euro ?- ?ammontare")
 57.         replace code = "c00_10_f"  if ustrregexm(d, "da 0 a 10000 euro ?- ?frequenza")
 58.         replace code = "c00_10_a"  if ustrregexm(d, "da 0 a 10000 euro ?- ?ammontare")
 59.         replace code = "c10_15_f"  if ustrregexm(d, "da 10000 a 15000 euro ?- ?frequenza")
 60.         replace code = "c10_15_a"  if ustrregexm(d, "da 10000 a 15000 euro ?- ?ammontare")
 61.         replace code = "c15_26_f"  if ustrregexm(d, "da 15000 a 26000 euro ?- ?frequenza")
 62.         replace code = "c15_26_a"  if ustrregexm(d, "da 15000 a 26000 euro ?- ?ammontare")
 63.         replace code = "c26_55_f"  if ustrregexm(d, "da 26000 a 55000 euro ?- ?frequenza")
 64.         replace code = "c26_55_a"  if ustrregexm(d, "da 26000 a 55000 euro ?- ?ammontare")
 65.         replace code = "c55_75_f"  if ustrregexm(d, "da 55000 a 75000 euro ?- ?frequenza")
 66.         replace code = "c55_75_a"  if ustrregexm(d, "da 55000 a 75000 euro ?- ?ammontare")
 67.         replace code = "c75_120_f" if ustrregexm(d, "da 75000 a 120000 euro ?- ?frequenza")
 68.         replace code = "c75_120_a" if ustrregexm(d, "da 75000 a 120000 euro ?- ?ammontare")
 69.         replace code = "c120p_f"   if ustrregexm(d, "oltre 120000 euro ?- ?frequenza")
 70.         replace code = "c120p_a"   if ustrregexm(d, "oltre 120000 euro ?- ?ammontare")
 71.     }
 72. 
.     foreach c in ncontrib imp_f imp_a lav_f lav_a c00_10_f c10_15_f c15_26_f {
 73.         quietly count if code == "`c'"
 74.         if r(N) != 38 di as error "  `y': voce `c' trovata per " r(N) " CAP (attesi 38)"
 75.     }
 76.     quietly count if missing(valore)
 77.     local nmiss = r(N)
 78.     quietly levelsof cap
 79.     di as txt "  `y': " _N " righe, " r(r) " CAP, " `nmiss' " importi mancanti (oscurati)"
 80. 
.     keep anno cap descr d code valore
 81.     if `first' == 0 append using `acc'
 82.     quietly save `acc', replace
 83.     local first 0
 84. }
