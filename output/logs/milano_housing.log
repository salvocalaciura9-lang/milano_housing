  2.     capture confirm variable `s'2011 `s'2021
  3.     if !_rc local stubs `stubs' `s'
  4. }

. local kv nil name_ix valid_full valid_social

. foreach s of local stubs {
  2.     local kv `kv' `s'2011 `s'2021
  3. }

