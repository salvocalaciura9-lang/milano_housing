  6.         gen double pop_ok_`a'  = pop if !missing(`a')
  7.     }
  8.     collapse (mean) y_med_net y_med sh_nil_A60 = off_A60 sh_nil_A40 = off_A40 sh_nil_A60d = off_A60d ///
>              sh_nil_A60g = off_A60g (median) A60_median = A60 A60g_median = A60g ///
>              (min) A60_min = A60 (max) A60_max = A60 ///
>              (sum) pop_off_* pop_ok_* (count) n_nil = A60g, by(year)
  9.     foreach a in A60 A40 A60d A60g {
 10.         gen double sh_pop_`a' = pop_off_`a'/pop_ok_`a' if pop_ok_`a' > 0
 11.     }
 12.     drop pop_off_* pop_ok_*
 13.     label variable sh_pop_A60  "Quota di residenti in NIL oltre il 40% del netto (60 m2, un reddito)"
 14.     label variable sh_pop_A60g "Quota di residenti in NIL oltre il 30% del lordo (controllo)"
 15.     list year y_med_net A60_median sh_pop_A40 sh_pop_A60 sh_pop_A60d sh_pop_A60g, noobs sep(0) abbrev(12)
