. local S = $S_MAIN

. 
. foreach xv of global XW_VERSIONS {
  2.     di as txt _n "  {ul:Raccordo: `xv'}"
  3. 
.     *--- (a) quotazioni al CAP ---------------------------------------------*
.     omi2cap "$WORK/xw_omi_cap_`xv'.dta" "$WORK/omi_zone_year.dta" $Y0 $Y1
  4.     tempfile omicap
  5.     save `omicap'
  6. 
.     *--- (b) redditi, CPI e affordability -----------------------------------*
.     use "$WORK/irpef_cap_year.dta", clear
  7.     keep cap anno year ncontrib imp_f imp_a ybar_imp lav_f lav_a ybar_lav nlow15 sh_low15 nlow26 sh_low26
  8.     merge 1:1 cap year using `omicap'
  9.     di as txt "  CAP-anno: solo IRPEF (_merge = 1), solo quotazioni (_merge = 2):"
 10.     tab year _merge
 11.     keep if _merge == 3
 12.     drop _merge
 13.     capture confirm file "$WORK/cpi.dta"
 14.     if !_rc {
 15.         merge m:1 year using "$WORK/cpi.dta", keep(master match) nogen
 16.     }
 17.     else {
 18.         gen double cpi = .
 19.     }
 20. 
.     gen double AR     = 12*`S'*R_mid/ybar_imp
 21.     gen double AR_min = 12*`S'*R_min/ybar_imp
 22.     gen double AR_max = 12*`S'*R_max/ybar_imp
 23.     gen double AR_lav = 12*`S'*R_mid/ybar_lav
 24.     gen double AR_2p  = 12*`S'*R_mid/(2*ybar_imp)
 25.     gen double AP     = `S'*P_mid/ybar_imp
 26.     gen double AP_min = `S'*P_min/ybar_imp
 27.     gen double AP_max = `S'*P_max/ybar_imp
 28.     gen double AP_lav = `S'*P_mid/ybar_lav
 29.     foreach s of global S_LIST {
 30.         gen double AR_s`s' = 12*`s'*R_mid/ybar_imp
 31.         gen double AP_s`s' = `s'*P_mid/ybar_imp
 32.     }
 33.     bysort cap: egen double y_base = max(cond(year == $Y0A, ybar_imp, .))
 34.     egen double cpi_base = max(cond(year == $Y0A, cpi, .))
 35.     gen double ybench  = y_base*cpi/cpi_base
 36.     gen double AR_base = 12*`S'*R_mid/ybench
 37.     gen double AP_base = `S'*P_mid/ybench
 38.     gen double gap_lnAR = ln(AR_base) - ln(AR)
 39.     label variable AR       "Affitto annuo di `S' m2 / reddito imponibile medio"
 40.     label variable AP       "Prezzo di `S' m2 / reddito imponibile medio (anni)"
 41.     label variable AR_base  "Come AR con reddito $Y0A del CAP rivalutato col CPI"
 42.     label variable AP_base  "Come AP con reddito $Y0A del CAP rivalutato col CPI"
 43.     label variable AR_lav   "Come AR con reddito da lavoro dipendente medio"
 44.     label variable AR_2p    "Come AR con due percettori"
 45.     label variable gap_lnAR "log A base - log A corrente"
 46. 
.     foreach a in AR AR_min AR_max AR_lav AR_base AP AP_min AP_max AP_lav AP_base {
 47.         gen double ln`a' = ln(`a')
 48.         bysort cap: egen double t0 = max(cond(year == $Y0A, ln`a', .))
 49.         bysort cap: egen double t1 = max(cond(year == $Y1,  ln`a', .))
 50.         gen double dln`a' = t1 - t0
 51.         drop t0 t1
 52.     }
 53. 
.     bysort cap: egen double covR_min = min(cov_R)
 54.     bysort cap: egen double covP_min = min(cov_P)
 55.     gen byte cover_ok = (covR_min >= $COVER_MIN & !missing(covR_min))
 56.     egen byte tagc = tag(cap)
 57.     di as txt "  Copertura minima delle zone quotate per CAP (regola: >= $COVER_MIN):"
 58.     tabstat covR_min covP_min if tagc, stats(n min p25 p50 max)
 59.     list cap covR_min covP_min if tagc & cover_ok == 0, noobs
 60.     quietly count if tagc & cover_ok == 1
 61.     di as txt "  CAP che rispettano la regola di copertura: " r(N)
 62.     drop tagc
 63. 
.     tabstat AR AR_base AP AP_base, by(year) stats(n p25 p50 p75) format(%9.3f)
 64.     tempfile aff
 65.     save `aff'
 66. 
.     *--- (c) residenti e uscite allocati al CAP ------------------------------*
.     use "$WORK/ds205_nil_year.dta", clear
 67.     local mv ""
 68.     capture confirm variable canc_ac
 69.     if !_rc local mv "canc_ac canc_es canc_alt canc_ac_it canc_ac_st"
 70.     keep nil year pop emig immig pop65 minors foreign fam fam1 `mv'
 71.     joinby nil using "$WORK/xw_nil_cap_`xv'.dta"
 72.     foreach v in pop emig immig pop65 minors foreign fam fam1 `mv' {
 73.         quietly replace `v' = `v'*w
 74.     }
 75.     collapse (sum) pop emig immig pop65 minors foreign fam fam1 `mv', by(cap year)
 76.     foreach v in pop emig immig pop65 minors foreign fam fam1 `mv' {
 77.         rename `v' `v'_al
 78.         label variable `v'_al "`v' allocato al CAP (stima con pesi `xv')"
 79.     }
 80.     xtset cap year
 81.     gen double r_emig  = 1000*emig_al/L.pop_al  if L.pop_al > 0 & !missing(L.pop_al)
 82.     gen double r_immig = 1000*immig_al/L.pop_al if L.pop_al > 0 & !missing(L.pop_al)
 83.     gen double sh_a65  = pop65_al/pop_al
 84.     gen double sh_foreign = foreign_al/pop_al
 85.     gen double sh_fam1 = fam1_al/fam_al
 86.     label variable r_emig "Uscite per 1.000 residenti (allocate)"
 87.     if "`mv'" != "" {
 88.         gen double r_ac  = 1000*canc_ac_al/L.pop_al if L.pop_al > 0 & !missing(L.pop_al)
 89.         gen double r_mov = 1000*(canc_ac_al + canc_es_al)/L.pop_al if L.pop_al > 0 & !missing(L.pop_al)
 90.         label variable r_ac  "Trasferimenti verso altri comuni italiani per 1.000 (allocati)"
 91.         label variable r_mov "Trasferimenti verso altri comuni o l'estero per 1.000 (allocati)"
 92.     }
 93. 
.     *--- (d) pannello CAP x anno 2011-2024 con affordability 2019-2023 -------*
.     merge 1:1 cap year using `aff', keep(master match)
 94.     di as txt "  CAP-anno con affordability: " _N " righe totali; abbinate:"
 95.     tab _merge
 96.     drop _merge
 97. 
.     bysort cap: egen double pop2019c    = max(cond(year == 2019, pop_al, .))
 98.     bysort cap: egen double pct65_2019c = max(cond(year == 2019, 100*sh_a65, .))
 99.     gen double lnpop2019c = ln(pop2019c)
100.     bysort cap: egen double shlow_base  = max(cond(year == $Y0A, sh_low15, .))
101.     bysort cap: egen byte   cover_okc   = max(cover_ok)
102.     replace cover_ok = cover_okc
103.     drop cover_okc
104.     egen byte tagc = tag(cap)
105.     quietly summarize shlow_base if tagc, detail
106.     gen byte vuln = (shlow_base > r(p50)) if !missing(shlow_base)
107.     drop tagc
108.     label variable vuln "Quota 0-15.000 EUR nel $Y0A sopra la mediana dei CAP (definita prima)"
109. 
.     *--- (e) upgrading sociale portato al CAP ---------------------------------*
.     if $IX_OK == 1 {
110.         preserve
111.         local gfile "$WORK/gentrif_nilnew.dta"
112.         if "$NILNEW_OK" != "1" local gfile "$WORK/gentrif_nil.dta"
113.         use "`gfile'", clear
114.         keep nil G_social dI_common dI_paper
115.         merge 1:1 nil using `pop11', keep(master match) nogen
116.         joinby nil using "$WORK/xw_nil_cap_`xv'.dta"
117.         gen double a = w*pop2011
118.         foreach g in G_social dI_common dI_paper {
119.             gen double ag_`g' = a*`g'
120.             gen double ao_`g' = a if !missing(`g')
121.         }
122.         collapse (sum) ag_* ao_* a, by(cap)
123.         foreach g in G_social dI_common dI_paper {
124.             gen double `g'_cap = ag_`g'/ao_`g' if ao_`g' > 0
125.             gen double cov_`g' = ao_`g'/a
126.         }
127.         keep cap *_cap cov_*
128.         label variable G_social_cap  "Upgrading sociale medio del CAP (pesi: residenti 2011 x quota NIL)"
129.         label variable dI_common_cap "Variazione indice comune media del CAP"
130.         tempfile gcap
131.         save `gcap'
132.         restore
133.         merge m:1 cap using `gcap', keep(master match) nogen
134.     }
135. 
.     sort cap year
136.     save "$WORK/cap_panel_`xv'.dta", replace
137. 
.     *--- (f) sezione trasversale delle variazioni ----------------------------*
.     preserve
138.     keep if year == $Y1
139.     local kc cap dln* lnpop2019c pct65_2019c shlow_base vuln cover_ok covR_min covP_min ///
>         AR AR_base AP AP_base cov_R cov_P
140.     capture confirm variable G_social_cap
141.     if !_rc local kc `kc' G_social_cap dI_common_cap dI_paper_cap cov_G_social cov_dI_common cov_dI_paper
142.     keep `kc'
143.     save "$WORK/cap_cross_`xv'.dta", replace
144.     if "`xv'" == "main" export delimited using "$TAB/cap_affordability_change.csv", replace
145.     restore
146. 
.     *--- (g) modello 2 ------------------------------------------------------*
.     if $IX_OK == 1 {
147.         preserve
148.         use "$WORK/cap_cross_`xv'.dta", clear
149.         local M2 "M2 CAP: variazione log affordability affitto $Y0A-$Y1"
150.         local Zc "lnpop2019c pct65_2019c"
151.         di as txt "  Nota: indice completo e rapporto costo/reddito condividono prezzi e redditi;"
152.         di as txt "  la loro correlazione e' in parte costruita dalle formule."
153.         pwcorr dlnAR dlnAP G_social_cap dI_common_cap if cover_ok == 1, obs
154. 
.         * ogni stima viene salvata solo se riesce (es. dlnAR_base richiede il CPI)
.         capture noisily regress dlnAR G_social_cap if cover_ok == 1, vce(hc3)
155.         if _rc == 0 saveres, model("`M2'") spec("bivariata [`xv']") coef(G_social_cap)
156.         capture noisily regress dlnAR G_social_cap `Zc' if cover_ok == 1, vce(hc3)
157.         if _rc == 0 saveres, model("`M2'") spec("principale [`xv']") coef(G_social_cap)
158. 
.         if "`xv'" == "main" {
159.             foreach y in dlnAP dlnAR_lav dlnAR_base dlnAR_min dlnAR_max {
160.                 capture noisily regress `y' G_social_cap `Zc' if cover_ok == 1, vce(hc3)
161.                 if _rc == 0 saveres, model("M2 CAP: `y'") spec("principale") coef(G_social_cap)
162.             }
163.             capture noisily regress dlnAR G_social_cap `Zc', vce(hc3)
164.             if _rc == 0 saveres, model("`M2'") spec("tutti i CAP (senza regola di copertura)") coef(G_social_cap)
165.             capture noisily regress dlnAR dI_common_cap `Zc' if cover_ok == 1, vce(hc3)
166.             if _rc == 0 saveres, model("`M2'") spec("indice completo a scala comune") ///
>                 coef(dI_common_cap) note("in parte meccanica: l'indice contiene prezzi e redditi")
167.         }
168.         restore
169.     }
170. }

