 30.     }
 31.     if "`T'" == "nil" save "$WORK/omi_nil_sem.dta", replace
 32.     restore
 33.     drop P_sem numP denP
 34.     * media annua dei semestri disponibili
.     collapse (mean) R = R_sem (min) cov, by(`tv' anno)
 35.     rename anno year
 36.     label variable R "Affitto OMI, punto medio (EUR/m2 lordo/mese), media dei semestri"
 37.     label variable cov "Copertura minima con zone OMI quotate"
 38.     if "`T'" == "nil" save "$WORK/omi_nil_year_long.dta", replace
 39.     if "`T'" == "zona" {
 40.         * la zonizzazione 2021 e' coerente solo dal 2014
.         keep if year >= 2014
 41.         save "$WORK/omi_zone21_year.dta", replace
 42.     }
 43. }
