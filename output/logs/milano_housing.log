. foreach c of local cl {
  2.     quietly regress `Y' lnAR `FE' if s_m3 & capid != `c', vce(cluster capid)
  3.     quietly summarize cap if capid == `c', meanonly
  4.     local cc = r(mean)
  5.     local cr = invttail(e(df_r), 0.025)
  6.     frame post loo3 (`cc') (_b[lnAR]) (_b[lnAR] - `cr'*_se[lnAR]) (_b[lnAR] + `cr'*_se[lnAR])
  7. }

