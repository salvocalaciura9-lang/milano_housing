-----------------------------------------------------------------------------
Number of observations               88   ->   176         
Number of variables                  22   ->   14          
j variable (2 values)                     ->   year
xij variables:
                        inc2011 inc2021   ->   inc
                    price2011 price2021   ->   price
                        edu2011 edu2021   ->   edu
                        emp2011 emp2021   ->   emp
                        idx2011 idx2021   ->   idx
                  zy_inc2011 zy_inc2021   ->   zy_inc
              zy_price2011 zy_price2021   ->   zy_price
                  zy_edu2011 zy_edu2021   ->   zy_edu
                  zy_emp2011 zy_emp2021   ->   zy_emp
-----------------------------------------------------------------------------

. 
. foreach v in inc price edu emp {
  2.     gen double zr_`v' = .
  3.     foreach t in 2011 2021 {
  4.         rpar `v' if year == `t'
  5.         quietly replace zr_`v' = (`v' - r(med))/r(iqr) if year == `t'
  6.     }
  7. }
