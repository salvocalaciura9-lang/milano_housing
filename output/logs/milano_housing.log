. foreach T in nil zona {
  2.     tempfile w_`T'
  3.     omi_weights `T' `w_`T''
  4.     use `sem', clear
  5.     if "`T'" == "nil" {
  6.         * La zona C14 (Porta Nuova) e' quotata solo dal 2018S2, ma e' gia' nella
.         * mappa 2014-2024: prima la sua area resterebbe scoperta (Porta Garibaldi
.         * fuori dal pannello, salto artificiale a Isola nel 2018S2). Fino al
.         * 2018S1 le si attribuisce l'affitto della C12, da cui e' stata ricavata
.         * (nel 2018S2 C14 15,0 e C12 15,6 EUR/m2). Solo per i NIL: a livello di
.         * zona (modulo 19) la C14 resta senza dati prima del 2018S2.
.         bysort anno sem: egen byte hasC14 = max(z == "C14")
  7.         expand 2 if z == "C12" & scheme == 21 & !hasC14, gen(dupC14)
  8.         replace z = "C14" if dupC14
  9.         drop hasC14 dupC14
 10.     }
 11.     joinby scheme z using `w_`T''
 12.     local tv = cond("`T'" == "zona", "zona", "nil")
 13.     gen double num = npt*R_mid
 14.     gen double den = npt if !missing(R_mid)
 15.     gen double numP = npt*P_mid
 16.     gen double denP = npt if !missing(P_mid)
 17.     collapse (sum) num den numP denP (first) tot, by(`tv' anno sem)
 18.     gen double R_sem = num/den if den > 0
 19.     gen double P_sem = numP/denP if denP > 0
 20.     gen double cov = den/tot
 21.     replace R_sem = . if cov < `COV'
 22.     replace P_sem = . if denP/tot < `COV'
 23.     * versione semestrale (per il diff-in-diff del modulo 19)
.     preserve
 24.     rename (anno R_sem P_sem) (year R P)
 25.     label variable R "Affitto OMI, punto medio (EUR/m2 lordo/mese)"
 26.     label variable P "Compravendita OMI, punto medio (EUR/m2 lordo)"
 27.     if "`T'" == "zona" {
