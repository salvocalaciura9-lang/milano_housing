. capture frame drop m3

. frame create m3 str70 spec str12 coef double b double se double lb double ub ///
>     double p double p_boot double lb_boot double ub_boot long N long G

. capture program drop m3post

. program define m3post
  1.     syntax , Spec(string) Coef(string) [Boot]
  2.     tempname b se
  3.     scalar `b' = _b[`coef']
  4.     scalar `se' = _se[`coef']
  5.     local df = e(df_r)
  6.     if missing(`df') {
  7.         local crit = invnormal(0.975)
  8.         local p = 2*normal(-abs(`b'/`se'))
  9.     }
 10.     else {
 11.         local crit = invttail(`df', 0.025)
 12.         local p = 2*ttail(`df', abs(`b'/`se'))
 13.     }
 14.     local pb = .
 15.     local lbb = .
 16.     local ubb = .
 17.     if "`boot'" != "" {
 18.         capture noisily boottest `coef', reps($BOOTREPS) weighttype(webb) seed($SEED) nograph
 19.         if _rc == 0 {
 20.             local pb = r(p)
 21.             capture matrix CI = r(CI)
 22.             if _rc == 0 {
 23.                 local lbb = CI[1,1]
 24.                 local ubb = CI[1,2]
 25.             }
 26.         }
 27.     }
 28.     local g = e(N_clust)
 29.     frame post m3 ("`spec'") ("`coef'") (`b') (`se') (`b' - `crit'*`se') (`b' + `crit'*`se') ///
>         (`p') (`pb') (`lbb') (`ubb') (e(N)) (`g')
 30.     di as txt "  -> " as res "`spec'" as txt ": " as res %8.3f `b' as txt "  IC95 [" %7.3f `b' - `crit'*`se' ///
>         "; " %7.3f `b' + `crit'*`se' "]  p = " %5.3f `p' "  p boot = " %5.3f `pb' "  N = " e(N)
 31. end

. 
. *------------------------------------------------------------------------------*
. * T1. Descrittive: quanta variazione resta dopo gli effetti fissi
. *------------------------------------------------------------------------------*
. di as txt _n "  {ul:T1. Descrittive del campione M3 (35 CAP x 5 anni)}"

  T1. Descrittive del campione M3 (35 CAP x 5 anni)

. capture frame drop t1

. frame create t1 str40 var double mean double sd_tot double sd_between double sd_within double r2_fe

. foreach v in `Y' lnAR lnR lnY {
  2.     quietly summarize `v' if s_m3
  3.     local m = r(mean)
  4.     local st = r(sd)
  5.     preserve
  6.     quietly keep if s_m3
  7.     quietly collapse (mean) mv = `v', by(capid)
  8.     quietly summarize mv
  9.     local sb = r(sd)
 10.     restore
 11.     quietly regress `v' i.capid i.year if s_m3
 12.     local r2 = e(r2)
 13.     tempvar w
 14.     quietly predict double `w' if s_m3, residuals
 15.     quietly summarize `w'
 16.     local sw = r(sd)
 17.     local lab : variable label `v'
 18.     frame post t1 ("`v'") (`m') (`st') (`sb') (`sw') (`r2')
 19.     di as txt "  " %-8s "`v'" "  media " as res %8.3f `m' as txt "  sd tot " as res %7.4f `st' ///
>         as txt "  sd between " as res %7.4f `sb' as txt "  sd within " as res %7.4f `sw' ///
>         as txt "  R2 FE " as res %5.3f `r2'
 20. }
