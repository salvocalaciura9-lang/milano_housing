. * leave-one-CAP-out
. capture frame drop loo

. frame create loo str40 spec long capid_out long cap_out double b double p

. capture program drop loorun

. program define loorun
  1.     args spec dep x cond
  2.     quietly levelsof capid if `cond', local(cl)
  3.     foreach c of local cl {
  4.         quietly regress `dep' `x' i.year i.capid if `cond' & capid != `c', vce(cluster capid)
  5.         quietly summarize cap if capid == `c', meanonly
  6.         local cc = r(mean)
  7.         frame post loo ("`spec'") (`c') (`cc') (_b[`x']) (2*ttail(e(df_r), abs(_b[`x']/_se[`x'])))
  8.     }
  9. end

. loorun "principale" r_lead1 lnAR "s_fe"

. loorun "pressione: lnAR_base" r_lead1 lnAR_base "s_fe & !missing(lnAR_base)"

. loorun "esito in t+2" r_lead2 lnAR "s_fe2"

. frame loo {
.     export delimited using "$TAB/robust_loo.csv", replace
file C:/Users/Salvatore/Downloads/milano_housing_stata/milano_housing/output/tables/robust_loo.csv saved
