. *------------------------------------------------------------------------------*
. * 0. Programmi
. *------------------------------------------------------------------------------*
. * csatt: ATT di Callaway e Sant'Anna con periodo base universale (g - step).
. *   Per ogni gruppo g e periodo t:
. *   ATT(g,t) = media [Y_t - Y_base] dei trattati g - media [Y_t - Y_base] dei controlli,
. *   controlli = aree del campione mai esposte o con apertura dopo max(t, base).
. *   r(att) = media degli ATT(g,t) dopo l'apertura (t da g a tmax), pesata per la
. *            numerosita' del gruppo;
. *   r(pre) = stessa media sugli anni prima (da g - prewin*step a g - 2*step): placebo.
. capture program drop csatt

. program define csatt, rclass
  1.     syntax varname, Unit(varname) Time(varname) Cohort(varname) Sample(varname) ///
>         Step(real) Tmax(real) [Prewin(integer 8) ESframe(string)]
  2.     local y `varlist'
  3.     tempvar yb dy trt ctl mT mC
  4.     quietly levelsof `cohort' if `cohort' > 0 & `sample', local(G)
  5.     local num 0
  6.     local den 0
  7.     local nump 0
  8.     local denp 0
  9.     if "`esframe'" != "" {
 10.         capture frame drop `esframe'
 11.         frame create `esframe' double g double t double att long nT
 12.     }
 13.     foreach g of local G {
 14.         local b = `g' - `step'
 15.         quietly {
 16.             capture drop `yb' `dy' `trt' `ctl' `mT' `mC'
 17.             bysort `unit': egen double `yb' = max(cond(abs(`time' - `b') < 1e-6, `y', .))
 18.             gen double `dy' = `y' - `yb' if `sample'
 19.             gen byte `trt' = abs(`cohort' - `g') < 1e-6 & `sample'
 20.             gen byte `ctl' = `sample' & !`trt' & (`cohort' == 0 | `cohort' > max(`time', `b') + 1e-6)
 21.             bysort `time': egen double `mT' = mean(cond(`trt', `dy', .))
 22.             bysort `time': egen double `mC' = mean(cond(`ctl', `dy', .))
 23.             count if `trt' & abs(`time' - `b') < 1e-6 & !missing(`yb')
 24.             local ng = r(N)
 25.             levelsof `time' if `time' <= `tmax' + 1e-6, local(T)
 26.         }
 27.         if `ng' == 0 continue
 28.         foreach t of local T {
 29.             quietly summarize `mT' if abs(`time' - `t') < 1e-6, meanonly
 30.             local a = r(mean)
 31.             quietly summarize `mC' if abs(`time' - `t') < 1e-6, meanonly
 32.             local a = `a' - r(mean)
 33.             if missing(`a') continue
 34.             if `t' >= `g' - 1e-6 {
 35.                 local num = `num' + `ng'*`a'
 36.                 local den = `den' + `ng'
 37.             }
 38.             if `t' <= `g' - 2*`step' + 1e-6 & `t' >= `g' - `prewin'*`step' - 1e-6 {
 39.                 local nump = `nump' + `ng'*`a'
 40.                 local denp = `denp' + `ng'
 41.             }
 42.             if "`esframe'" != "" frame post `esframe' (`g') (`t') (`a') (`ng')
 43.         }
 44.     }
 45.     return scalar att = cond(`den' > 0, `num'/`den', .)
 46.     return scalar pre = cond(`denp' > 0, `nump'/`denp', .)
 47. end

. 
. * permutazione dei gruppi di apertura tra le aree del campione
. capture mata: mata drop m4_perm()

. mata:
------------------------------------------------- mata (type end to exit) --------------------------------------------------------------------------------------
: void m4_perm(string scalar c, string scalar sel, string scalar out)
> {
>     real colvector v
>     v = st_data(., c, sel)
>     st_store(., out, sel, jumble(v))
> }

: end
----------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. * m4run: stima, permutazione, salvataggio di una riga dei risultati
. capture program drop m4run

. program define m4run
  1.     syntax varname, Unit(varname) Time(varname) Cohort(varname) Sample(varname) ///
>         Step(real) Tmax(real) Spec(string) Perms(integer) [Prewin(integer 8) ESframe(string)]
  2.     local y `varlist'
  3.     csatt `y', unit(`unit') time(`time') cohort(`cohort') sample(`sample') step(`step') ///
>         tmax(`tmax') prewin(`prewin') esframe(`esframe')
  4.     local att = r(att)
  5.     local pre = r(pre)
  6.     tempvar first cpf cp
  7.     quietly {
  8.         bysort `unit' (`time'): gen byte `first' = _n == 1 & `sample'
  9.         count if `first' & `cohort' > 0
 10.         local nT = r(N)
 11.         count if `first' & `cohort' == 0
 12.         local nC = r(N)
 13.     }
 14.     local ext 0
 15.     local extp 0
 16.     local ok 0
 17.     forvalues j = 1/`perms' {
 18.         quietly {
 19.             capture drop `cpf' `cp'
 20.             gen double `cpf' = .
 21.             mata: m4_perm("`cohort'", "`first'", "`cpf'")
 22.             bysort `unit': egen double `cp' = max(`cpf')
 23.         }
 24.         csatt `y', unit(`unit') time(`time') cohort(`cp') sample(`sample') step(`step') ///
>             tmax(`tmax') prewin(`prewin')
 25.         if !missing(r(att)) {
 26.             local ++ok
 27.             if abs(r(att)) >= abs(`att') - 1e-12 local ++ext
 28.             if abs(r(pre)) >= abs(`pre') - 1e-12 local ++extp
 29.         }
 30.     }
 31.     local p = (`ext' + 1)/(`ok' + 1)
 32.     local pp = (`extp' + 1)/(`ok' + 1)
 33.     frame post m4cs ("`spec'") ("`y'") (`att') (`p') (`pre') (`pp') (`nT') (`nC')
 34.     di as txt "  -> " as res "`spec'" as txt " [`y']: effetto " as res %8.4f `att' ///
>         as txt "  p perm = " as res %5.3f `p' as txt "   placebo pre " as res %8.4f `pre' ///
>         as txt "  p perm = " as res %5.3f `pp' as txt "   trattate " `nT' "  controlli " `nC'
 35. end

. 
