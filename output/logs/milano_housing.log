. program define omi_weights
  1.     args target out
  2.     use "$WORK/xwa_grid.dta", clear
  3.     if "`target'" == "nil" keep if !missing(nil)
  4.     if "`target'" == "zona" keep if zona != ""
  5.     rename zona zona21
  6.     tempfile g
  7.     save `g'
  8.     bysort `=cond("`target'"=="zona","zona21","nil")': gen long tot = _N
  9.     tempfile gt
 10.     save `gt'
 11.     clear
 12.     tempfile acc
 13.     local first 1
 14.     foreach s in 11 21 25 {
 15.         use `gt', clear
 16.         local tv = cond("`target'" == "zona", "zona21", "nil")
 17.         gen str3 z = zona`s'
 18.         contract `tv' z tot, freq(npt)
 19.         gen int scheme = `s'
 20.         if `first' == 0 append using `acc'
 21.         save `acc', replace
 22.         local first 0
 23.     }
 24.     if "`target'" == "zona" rename zona21 zona
 25.     save `out', replace
 26. end

