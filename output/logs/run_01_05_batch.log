. *==============================================================================*
. * 00_programs.do  -  programmi di supporto usati da tutti i moduli
. *
. *  imp_csv     importa un CSV come testo (prova ";" e poi ",")
. *  tonum       converte stringhe in numeri (virgola decimale, punti migliaia,
. *              N.D.), segnalando i valori non convertibili
. *  findvar     trova UNA colonna cercando una regex nel nome e nell'etichetta
. *              (import delimited conserva l'intestazione originale come etichetta)
. *  getvar      come findvar, poi rinomina la colonna con il nome canonico
. *  detectcode  individua la colonna i cui valori seguono un formato (CAP, zona OMI)
. *  rq7         quantile con la definizione "type 7" di R (default di R)
. *  rpar        mediana e IQR (type 7) di una variabile
. *  checkval    confronta un valore calcolato con un valore atteso del documento
. *  saveres     salva coefficiente, IC e N dell'ultima stima nel frame "results"
. *==============================================================================*
. 
. version 16

. 
. *------------------------------------------------------------------------------*
. capture program drop imp_csv

. program define imp_csv
  1.     version 16
  2.     syntax using/ [, Delim(string)]
  3.     if `"`delim'"' != "" {
  4.         import delimited using `"`using'"', delimiters(`"`delim'"') varnames(1) ///
>             stringcols(_all) encoding("utf-8") bindquote(strict) clear
  5.     }
  6.     else {
  7.         import delimited using `"`using'"', delimiters(";") varnames(1) ///
>             stringcols(_all) encoding("utf-8") bindquote(strict) clear
  8.         if c(k) <= 1 {
  9.             import delimited using `"`using'"', delimiters(",") varnames(1) ///
>                 stringcols(_all) encoding("utf-8") bindquote(strict) clear
 10.         }
 11.     }
 12.     di as txt "  importato " as res `"`using'"' as txt ": " c(N) " righe, " c(k) " colonne"
 13. end

. 
. *------------------------------------------------------------------------------*
. capture program drop tonum

. program define tonum
  1.     version 16
  2.     syntax varlist
  3.     foreach v of local varlist {
  4.         capture confirm string variable `v'
  5.         if _rc continue
  6.         quietly {
  7.             replace `v' = ustrtrim(`v')
  8.             replace `v' = "" if inlist(upper(`v'), "N.D.", "N.D", "ND", "NA", "N/A", "-", ".", "NULL", "NAN")
  9.             replace `v' = subinstr(`v', " ", "", .)
 10.             * con la virgola decimale i punti sono separatori delle migliaia
.             replace `v' = subinstr(`v', ".", "", .) if strpos(`v', ",") > 0
 11.             replace `v' = subinstr(`v', ",", ".", .)
 12.             * piu' di un punto e nessuna virgola: punti delle migliaia
.             replace `v' = subinstr(`v', ".", "", .) if length(`v') - length(subinstr(`v', ".", "", .)) > 1
 13.         }
 14.         tempvar x
 15.         quietly gen double `x' = real(`v')
 16.         quietly count if missing(`x') & `v' != ""
 17.         if r(N) > 0 {
 18.             di as error "  tonum: `v' ha " r(N) " valori non numerici, posti a missing"
 19.         }
 20.         local lab : variable label `v'
 21.         order `x', after(`v')
 22.         drop `v'
 23.         rename `x' `v'
 24.         label variable `v' `"`lab'"'
 25.     }
 26. end

. 
. *------------------------------------------------------------------------------*
. capture program drop findvar

. program define findvar, rclass
  1.     version 16
  2.     syntax , Pattern(string) [EXclude(string) Required]
  3.     local hits
  4.     foreach v of varlist _all {
  5.         local lab : variable label `v'
  6.         local s = ustrlower(`"`v' `lab'"')
  7.         if ustrregexm(`"`s'"', `"`pattern'"') {
  8.             if `"`exclude'"' == "" {
  9.                 local hits `hits' `v'
 10.             }
 11.             else if !ustrregexm(`"`s'"', `"`exclude'"') {
 12.                 local hits `hits' `v'
 13.             }
 14.         }
 15.     }
 16.     local n : word count `hits'
 17.     if `n' == 1 {
 18.         return local varname `hits'
 19.         exit
 20.     }
 21.     if `n' == 0 & "`required'" == "" {
 22.         return local varname ""
 23.         exit
 24.     }
 25.     di as error "findvar: il criterio [`pattern'] trova `n' colonne: `hits'"
 26.     di as error "Colonne disponibili:"
 27.     describe, simple
 28.     exit 111
 29. end

. 
. *------------------------------------------------------------------------------*
. capture program drop getvar

. program define getvar
  1.     version 16
  2.     syntax anything(name=canon), Pattern(string) [EXclude(string) OPTional]
  3.     local req = cond("`optional'" == "", "required", "")
  4.     findvar, pattern(`"`pattern'"') exclude(`"`exclude'"') `req'
  5.     local v `r(varname)'
  6.     if "`v'" == "" {
  7.         di as txt "  (colonna facoltativa assente: `canon')"
  8.         exit
  9.     }
 10.     if "`v'" != "`canon'" {
 11.         capture confirm new variable `canon'
 12.         if _rc {
 13.             di as error "getvar: esiste gia' una variabile chiamata `canon'"
 14.             exit 110
 15.         }
 16.         rename `v' `canon'
 17.     }
 18.     di as txt "  `canon' <- `v'"
 19. end

. 
. *------------------------------------------------------------------------------*
. * Restituisce in r(varname) la colonna con la quota piu' alta di valori che
. * rispettano la regex (minimo 50%); r(share) e' quella quota.
. capture program drop detectcode

. program define detectcode, rclass
  1.     version 16
  2.     syntax , Regex(string)
  3.     local best ""
  4.     local bestk = 0
  5.     foreach v of varlist _all {
  6.         if inlist("`v'", "_ID", "_CX", "_CY") continue
  7.         tempvar s
  8.         capture confirm string variable `v'
  9.         if _rc {
 10.             quietly gen `s' = string(`v', "%12.0f")
 11.         }
 12.         else {
 13.             quietly gen `s' = upper(ustrtrim(`v'))
 14.         }
 15.         quietly count if ustrregexm(`s', `"`regex'"')
 16.         local k = r(N)
 17.         drop `s'
 18.         if `k' > `bestk' {
 19.             local best `v'
 20.             local bestk = `k'
 21.         }
 22.     }
 23.     if "`best'" == "" | `bestk' < 0.5*_N {
 24.         di as error "detectcode: nessuna colonna con valori del tipo [`regex']. Indicare il campo nel master."
 25.         exit 111
 26.     }
 27.     di as txt "  colonna individuata: `best' (" %4.1f 100*`bestk'/_N "% dei valori nel formato atteso)"
 28.     return local varname `best'
 29.     return scalar share = `bestk'/_N
 30. end

. 
. *------------------------------------------------------------------------------*
. * Quantile "type 7" (R, default di quantile() e IQR()): h = (n-1)p + 1
. capture mata mata drop _rq7()

. mata:
------------------------------------------------- mata (type end to exit) --------------------------------------------------------------------------------------
: void _rq7(string scalar v, string scalar touse, real scalar p)
> {
>     real colvector x
>     real scalar n, h, lo, hi
>     x = st_data(., v, touse)
>     x = select(x, x :< .)
>     n = rows(x)
>     st_numscalar("__rq7n", n)
>     if (n == 0) {
>         st_numscalar("__rq7q", .)
>         return
>     }
>     x = sort(x, 1)
>     h = (n - 1) * p + 1
>     lo = floor(h)
>     hi = ceil(h)
>     st_numscalar("__rq7q", x[lo] + (h - lo) * (x[hi] - x[lo]))
> }

: end
----------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. capture program drop rq7

. program define rq7, rclass
  1.     version 16
  2.     syntax varname(numeric) [if] [in], P(real)
  3.     marksample touse
  4.     mata: _rq7("`varlist'", "`touse'", `p')
  5.     return scalar q = scalar(__rq7q)
  6.     return scalar N = scalar(__rq7n)
  7.     scalar drop __rq7q __rq7n
  8. end

. 
. capture program drop rpar

. program define rpar, rclass
  1.     version 16
  2.     syntax varname(numeric) [if] [in]
  3.     marksample touse
  4.     tempname m q1 q3
  5.     rq7 `varlist' if `touse', p(0.5)
  6.     scalar `m' = r(q)
  7.     local n = r(N)
  8.     rq7 `varlist' if `touse', p(0.25)
  9.     scalar `q1' = r(q)
 10.     rq7 `varlist' if `touse', p(0.75)
 11.     scalar `q3' = r(q)
 12.     if (`q3' - `q1') == 0 {
 13.         di as error "  rpar: IQR nullo per `varlist'"
 14.     }
 15.     return scalar med = `m'
 16.     return scalar q1  = `q1'
 17.     return scalar q3  = `q3'
 18.     return scalar iqr = `q3' - `q1'
 19.     return scalar N   = `n'
 20. end

. 
. *------------------------------------------------------------------------------*
. capture program drop checkval

. program define checkval
  1.     version 16
  2.     syntax , Label(string) Expected(real) [Value(string) Tol(real 0.01)]
  3.     if "`value'" == "" | "`value'" == "." {
  4.         di as error "  [MANCANTE] `label': valore non calcolabile"
  5.         exit
  6.     }
  7.     local d = abs(`value' - `expected')
  8.     if `d' <= `tol' {
  9.         di as txt "  [OK] `label': " as res %14.4f `value' as txt "  (atteso " %14.4f `expected' ")"
 10.     }
 11.     else {
 12.         di as error "  [DIVERSO] `label': " %14.4f `value' "  (atteso " %14.4f `expected' ") -> verificare i dati"
 13.     }
 14. end

. 
. *------------------------------------------------------------------------------*
. capture program drop saveres

. program define saveres
  1.     version 16
  2.     syntax , Model(string) Spec(string) Coef(string) [Note(string) ///
>         PBoot(real -999) LBBoot(real -999) UBBoot(real -999)]
  3.     capture confirm frame results
  4.     if _rc {
  5.         frame create results str244 model str244 spec str60 coef double b double se ///
>             double lb double ub double p double p_boot double lb_boot double ub_boot ///
>             long N str20 cmd str244 note
  6.     }
  7.     tempname b se crit lb ub p
  8.     capture scalar `b' = _b[`coef']
  9.     if _rc {
 10.         di as error "saveres: coefficiente `coef' non presente nell'ultima stima"
 11.         exit 111
 12.     }
 13.     scalar `se' = _se[`coef']
 14.     if missing(e(df_r)) {
 15.         scalar `crit' = invnormal(0.975)
 16.         scalar `p'    = 2*normal(-abs(`b'/`se'))
 17.     }
 18.     else {
 19.         scalar `crit' = invttail(e(df_r), 0.025)
 20.         scalar `p'    = 2*ttail(e(df_r), abs(`b'/`se'))
 21.     }
 22.     scalar `lb' = `b' - `crit'*`se'
 23.     scalar `ub' = `b' + `crit'*`se'
 24.     local pb  = cond(`pboot'  == -999, ., `pboot')
 25.     local lbb = cond(`lbboot' == -999, ., `lbboot')
 26.     local ubb = cond(`ubboot' == -999, ., `ubboot')
 27.     local cmd "`e(cmd)'"
 28.     frame post results ("`model'") ("`spec'") ("`coef'") (`b') (`se') (`lb') (`ub') ///
>         (`p') (`pb') (`lbb') (`ubb') (e(N)) ("`cmd'") ("`note'")
 29.     di as txt "  -> " as res "`spec'" as txt ": `coef' = " as res %9.4f `b' ///
>         as txt "  IC95 [" %9.4f `lb' "; " %9.4f `ub' "]  N = " e(N)
 30. end

. 
end of do-file

